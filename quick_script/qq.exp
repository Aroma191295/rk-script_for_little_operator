#!/usr/bin/expect

################## Инструкция ######################################

# Использовать:

# qq 10.0.0.1 - подключение под собой telnet
# qq-ssh 10.0.0.1 - подключение под собой ssh
# qq 10.0.0.1 admin - подключение под админом telnet
# qq-ssh 10.0.0.1 admin - подключение под админом ssh

# Создать alias:

# cat >> ~/.bash_aliases << EOF
# alias qq='<расположение файла>/qq.exp telnet'
# alias qq-ssh='<расположение файла>/qq.exp ssh'
# EOF

# chmod 700 <расположение файла>/qq.exp - дать права на выполнение

# source ~/.bashrc - перечитать файл с alias

# Учётные данные из .env в корне проекта (рядом с main.py):
# USER / PASS  — свои (по умолчанию)
# PASS_SSH     — пароль для режима admin

####################################################################

set script_dir [file dirname [file normalize [info script]]]
source [file join $script_dir "dotenv.tcl"]
init_dotenv $script_dir

# Установка аргументов
set timeout 10
set protocol [lindex $argv 0]
set ip [lindex $argv 1]

if {[llength $argv] >= 3} {
    set user [lindex $argv 2]
} else {
    set user [dotenv_require USER]
}

if {$user != "admin"} {
    set pass [dotenv_require PASS]
} else {
    set pass [dotenv_require PASS_SSH]
}

# Проверка протокола
if {$protocol != "ssh" && $protocol != "telnet"} {
    puts "Error: Protocol must be 'ssh' or 'telnet'"
    exit 1
}

if {$protocol == "ssh"} {
    # SSH
    spawn ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null $user@$ip
    
    expect {
        # Проверка на доступность
        timeout { puts "Timeout"; exit 1 }
        eof { puts "Connection closed"; exit 1 }
        "Connection refused" { puts "Connection refused"; exit 1 }
        
        # Подтверждение нового хоста
        "Are you sure you want to continue connecting (yes/no)?" {
            send "yes\r"
            exp_continue
        }
        
        # Запрос пароля
        "password:" {
            send "$pass\r"
            exp_continue
        }
                
        -re {[a-zA-Z0-9\-]+[#>]} {
            interact
            exit 0
        }
    }
    
} elseif {$protocol == "telnet"} {
    # Telnet
    spawn telnet $ip
    
    expect {
        # Проверка на доступность
        timeout {puts "Telnet Timeout"; exit 1}
        eof {puts "Telnet Connection closed"; exit 1}
        "Connection refused" {puts "Telnet Connection refused"; exit 1}
        
        # Ввод логина и пароля
        -re ".*:.*" {
            set buf $expect_out(buffer)
            if {[regexp -nocase "name|login|user" $buf]} {
                send "$user\r"
                exp_continue
            } elseif {[regexp -nocase "pass" $buf]} {
                send "$pass\r"
                exp_continue
            } else {
                send "\r"
                exp_continue
            }
        }
        
        -re {[a-zA-Z0-9\-]+[#>]} {
            interact
            exit 0
        }
    }
}
